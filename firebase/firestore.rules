rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isAdmin(){return signedIn() && request.auth.token.admin==true;}
  match /users/{uid} { allow read,write: if signedIn() && request.auth.uid==uid; }
  match /products/{id} {
   allow read: if resource.data.status=='published' || isAdmin() || (signedIn() && resource.data.supplierUid==request.auth.uid);
   allow create: if signedIn() && request.resource.data.supplierUid==request.auth.uid && request.resource.data.status=='pending';
   allow update: if isAdmin() || (signedIn() && resource.data.supplierUid==request.auth.uid && request.resource.data.status==resource.data.status);
   allow delete: if isAdmin();
  }
 }
}